rules_version = '2';
service cloud.firestore {
  function signedIn() { return request.auth != null; }
  function myUser() {
    return get(/databases/(default)/documents/users/$(request.auth.uid)).data;
  }
  function myClassroom(classroomId) {
    return signedIn() && myUser().classroomId == classroomId;
  }
  function masterEmail() { return 'ketarou85@gmail.com'; }
  function tokenEmail() {
    return signedIn() && 'email' in request.auth.token ? request.auth.token.email : null;
  }
  function isMaster() { return tokenEmail() == masterEmail(); }
  function isAllowlisted() {
    return tokenEmail() != null
      && exists(/databases/(default)/documents/teacherAllowlist/$(tokenEmail()));
  }
  function allowlistedTeacher() {
    return signedIn() && isAllowlisted() && myUser().role == 'teacher';
  }
  function teacherOf(classroomId) {
    return signedIn()
      && exists(/databases/(default)/documents/classrooms/$(classroomId))
      && get(/databases/(default)/documents/classrooms/$(classroomId)).data.teacherId == request.auth.uid;
  }
  function teacherOfArena(arenaId) {
    return exists(/databases/(default)/documents/arenas/$(arenaId))
      && teacherOf(get(/databases/(default)/documents/arenas/$(arenaId)).data.classroomId);
  }
  function roomParticipant(data) {
    return signedIn() && data.players is list
      && (data.players[0].uid == request.auth.uid
        || (data.players.size() > 1 && data.players[1].uid == request.auth.uid));
  }
  function roomTeacher(data) { return teacherOf(data.classroomId); }
  function roomReadyUpdate() {
    return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'updatedAt'])
      && resource.data.players.size() == 2
      && request.resource.data.players.size() == 2
      && (
        (resource.data.players[0].uid == request.auth.uid
          && request.resource.data.players[0].diff(resource.data.players[0]).affectedKeys().hasOnly(['ready'])
          && request.resource.data.players[0].ready == true
          && request.resource.data.players[1] == resource.data.players[1])
        ||
        (resource.data.players[1].uid == request.auth.uid
          && request.resource.data.players[1].diff(resource.data.players[1]).affectedKeys().hasOnly(['ready'])
          && request.resource.data.players[1].ready == true
          && request.resource.data.players[0] == resource.data.players[0])
      );
  }
  function validInitialUser(uid) {
    return signedIn() && request.auth.uid == uid
      && request.resource.data.keys().hasOnly(['nickname', 'role', 'classroomId', 'avatar'])
      && (!('avatar' in request.resource.data) || request.resource.data.avatar == 'frog')
      && (!('xp' in request.resource.data) || request.resource.data.xp == 0)
      && (!('stars' in request.resource.data) || request.resource.data.stars == 0)
      && (!('winCount' in request.resource.data) || request.resource.data.winCount == 0)
      && (!('streak' in request.resource.data) || request.resource.data.streak == 0)
      && (!('answerCount' in request.resource.data) || request.resource.data.answerCount == 0)
      && (!('correctAnswerCount' in request.resource.data) || request.resource.data.correctAnswerCount == 0)
      && (!('classroomId' in request.resource.data)
        || (exists(/databases/(default)/documents/classrooms/$(request.resource.data.classroomId))
          && get(/databases/(default)/documents/classrooms/$(request.resource.data.classroomId)).data.inviteCode == request.resource.data.classroomId
          && get(/databases/(default)/documents/classrooms/$(request.resource.data.classroomId)).data.locked == false))
      && (!('role' in request.resource.data)
        || request.resource.data.role == 'student'
        || (request.resource.data.role == 'teacher'
          && (isAllowlisted() || isMaster())
          && exists(/databases/(default)/documents/classrooms/$(request.resource.data.classroomId))
          && get(/databases/(default)/documents/classrooms/$(request.resource.data.classroomId)).data.teacherId == uid));
  }
  function validRoomCreate() {
    return signedIn()
      && request.resource.data.keys().hasOnly([
        'arenaId', 'classroomId', 'status', 'players', 'problemIds', 'showPlayers',
        'ttsEnabled', 'currentRound', 'roundEndsAt', 'winnerUid', 'updatedAt'
      ])
      && request.resource.data.status == 'waiting'
      && request.resource.data.winnerUid == null
      && request.resource.data.currentRound == 0
      && request.resource.data.players.size() == 1
      && request.resource.data.players[0].uid == request.auth.uid
      && request.resource.data.players[0].score == 0
      && request.resource.data.players[0].ready == false
      && request.resource.data.players[0].answeredRounds.size() == 0
      && myClassroom(request.resource.data.classroomId)
      && get(/databases/(default)/documents/arenas/$(request.resource.data.arenaId)).data.classroomId == request.resource.data.classroomId;
  }
  function validRoomJoin() {
    return signedIn()
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'players', 'updatedAt'])
      && resource.data.status == 'waiting'
      && resource.data.players.size() == 1
      && request.resource.data.players.size() == 2
      && request.resource.data.status == 'ready'
      && request.resource.data.players[0] == resource.data.players[0]
      && request.resource.data.players[0].uid != request.auth.uid
      && request.resource.data.players[1].uid == request.auth.uid
      && request.resource.data.players[1].score == 0
      && request.resource.data.players[1].ready == false
      && request.resource.data.players[1].answeredRounds.size() == 0
      && myClassroom(resource.data.classroomId);
  }
  match /databases/{database}/documents {
    match /teacherAllowlist/{email} {
      allow get: if isMaster() || (signedIn() && tokenEmail() == email);
      allow list, write: if isMaster();
    }
    match /users/{uid} {
      allow get, list: if signedIn() && (request.auth.uid == uid || myClassroom(resource.data.classroomId));
      allow create: if validInitialUser(uid);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nickname', 'role', 'classroomId', 'updatedAt'
        ])
        && (request.resource.data.get('role', null) == resource.data.get('role', null)
          || (resource.data.get('role', null) == null
            && (request.resource.data.get('role', null) == 'student'
              || (request.resource.data.get('role', null) == 'teacher'
                && (isAllowlisted() || isMaster())
                && exists(/databases/(default)/documents/classrooms/$(request.resource.data.classroomId))
                && get(/databases/(default)/documents/classrooms/$(request.resource.data.classroomId)).data.teacherId == uid))))
        && request.resource.data.get('xp', 0) == resource.data.get('xp', 0)
        && request.resource.data.get('stars', 0) == resource.data.get('stars', 0)
        && request.resource.data.get('unlockedAvatars', []) == resource.data.get('unlockedAvatars', [])
        && request.resource.data.get('unlockedTitles', []) == resource.data.get('unlockedTitles', [])
        && request.resource.data.get('winCount', 0) == resource.data.get('winCount', 0)
        && request.resource.data.get('streak', 0) == resource.data.get('streak', 0)
        && (request.resource.data.get('classroomId', null) == resource.data.get('classroomId', null)
          || (request.resource.data.get('role', null) == 'student'
            && exists(/databases/(default)/documents/classrooms/$(request.resource.data.classroomId))
            && get(/databases/(default)/documents/classrooms/$(request.resource.data.classroomId)).data.inviteCode == request.resource.data.classroomId
            && get(/databases/(default)/documents/classrooms/$(request.resource.data.classroomId)).data.locked == false));
      allow delete: if teacherOf(resource.data.classroomId);
    }
    match /classrooms/{classroomId} {
      allow get: if signedIn() && (resource.data.teacherId == request.auth.uid || myClassroom(classroomId) || resource.data.inviteCode == classroomId);
      allow list: if signedIn() && resource.data.teacherId == request.auth.uid;
      allow create: if signedIn() && (isAllowlisted() || isMaster())
        && request.resource.data.teacherId == request.auth.uid;
      allow update: if teacherOf(classroomId) && request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if teacherOf(classroomId);
    }
    match /arenas/{arenaId} {
      allow get, list: if signedIn() && (myClassroom(resource.data.classroomId) || teacherOf(resource.data.classroomId) || (allowlistedTeacher() && resource.data.locked == false));
      allow create: if teacherOf(request.resource.data.classroomId);
      allow update: if teacherOf(resource.data.classroomId)
        && request.resource.data.classroomId == resource.data.classroomId;
      allow delete: if teacherOf(resource.data.classroomId);
    }
    match /arenas/{arenaId}/problems/{problemId} {
      allow read: if teacherOfArena(arenaId)
        || (allowlistedTeacher()
          && get(/databases/(default)/documents/arenas/$(arenaId)).data.locked == false);
      allow write: if teacherOfArena(arenaId);
    }
    match /rooms/{roomId} {
      allow get: if signedIn() && (
        roomParticipant(resource.data)
        || roomTeacher(resource.data)
        || (resource.data.status == 'waiting' && myClassroom(resource.data.classroomId))
      );
      allow list: if signedIn() && (
        (resource.data.status == 'waiting' && myClassroom(resource.data.classroomId))
        || roomTeacher(resource.data)
      );
      // Creation, joining, readiness, answers, scores and outcomes are callable-only.
      allow create: if false;
      allow update: if roomTeacher(resource.data)
        && resource.data.status in ['waiting', 'ready', 'playing']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'abandoned';
      allow delete: if roomTeacher(resource.data);
    }
    match /roomSubmissions/{submissionId} { allow read, write: if false; }
    match /matchLocks/{lockId} { allow read, write: if false; }
    match /battles/{battleId} {
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create, update, delete: if false;
    }
    match /reports/{reportId} {
      allow read: if signedIn() && teacherOf(resource.data.classroomId);
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && myClassroom(request.resource.data.classroomId)
        && request.resource.data.status == 'open';
      allow update: if signedIn() && teacherOf(resource.data.classroomId);
      allow delete: if false;
    }
  }
}
