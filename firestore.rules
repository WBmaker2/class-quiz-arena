rules_version = '2';
service cloud.firestore {
  function isSignedIn() {
    return request.auth != null;
  }
  // (default) 리터럴 경로 사용: $(database) 변수는 에뮬레이터에서 null로 평가되어
  // get()/exists()가 실패한다. 단일 (default) DB만 쓰므로 리터럴이 안전하다.
  function masterEmail() {
    return 'ketarou85@gmail.com';
  }
  // 익명 로그인은 토큰에 email이 없어서 바로 읽으면 평가 오류가 난다.
  // 먼저 있는지 확인하고 읽는다.
  function tokenEmail() {
    return 'email' in request.auth.token ? request.auth.token.email : null;
  }
  function isMaster() {
    return isSignedIn() && tokenEmail() == masterEmail();
  }
  // 선생님 명단에 든 학교 계정인지 (이메일 키, 읽기 권한 없이 존재 확인용)
  function isAllowlisted() {
    return isSignedIn()
      && tokenEmail() != null
      && exists(/databases/(default)/documents/teacherAllowlist/$(tokenEmail()));
  }
  function teacherOf(classroomId) {
    return isSignedIn()
      && get(/databases/(default)/documents/classrooms/$(classroomId)).data.teacherId == request.auth.uid;
  }
  function teacherOfArena(arenaId) {
    return teacherOf(get(/databases/(default)/documents/arenas/$(arenaId)).data.classroomId);
  }
  // 대결방은 아레나를 거쳐 학급 선생님을 확인한다 (학급 삭제 시 함께 지우기용).
  function teacherOfRoom(roomId) {
    return teacherOfArena(get(/databases/(default)/documents/rooms/$(roomId)).data.arenaId);
  }
  function isOwner(uid) {
    return isSignedIn() && request.auth.uid == uid;
  }
  match /databases/{database}/documents {
    // 선생님 명단: 본인 문서 단건 확인 + 마스터 전체 관리
    match /teacherAllowlist/{email} {
      allow get: if isMaster() || (isSignedIn() && tokenEmail() == email);
      allow list: if isMaster();
      allow write: if isMaster();
    }
    match /users/{uid} {
      // 학급 Top20 리더보드는 classroomId+xp 조회, 로그인한 사용자만 읽는다 (최소 권한 유지).
      allow read: if isSignedIn();
      // role은 생성 시에만 정해지고 이후 본인이 바꿀 수 없음 (교사 사칭 방지).
      // 생성 시 teacher role은 명단·마스터만 가능 (join 사칭 방지).
      allow write: if isOwner(uid)
        && (!('role' in request.resource.data)
          || resource == null
          || request.resource.data.role == resource.data.role)
        && (resource != null
          || !('role' in request.resource.data)
          || request.resource.data.role != 'teacher'
          || isAllowlisted()
          || isMaster());
      allow delete: if teacherOf(resource.data.classroomId);
    }
    match /classrooms/{id} {
      allow read: if isSignedIn();
      // 학급 개설은 명단 선생님·마스터만 (무단 개설 방지)
      allow create: if isSignedIn() && (isAllowlisted() || isMaster());
      allow update: if isSignedIn() && resource.data.teacherId == request.auth.uid;
      // 본인 학급만 삭제 (아레나·대결방은 앱에서 먼저 함께 지운다)
      allow delete: if teacherOf(id);
    }
    match /arenas/{id} {
      allow read: if isSignedIn();
      // 자기 학급의 선생님만 (타 학급 쓰기 방지).
      // 삭제 시 request.resource는 null이라 resource(기존 문서)로 확인한다.
      allow create, update: if teacherOf(request.resource.data.classroomId);
      allow delete: if teacherOf(resource.data.classroomId);
    }
    match /arenas/{arenaId}/problems/{pid} {
      allow read: if isSignedIn();
      allow write: if teacherOfArena(arenaId);
    }
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && request.resource.data.status in ['waiting', 'ready', 'playing', 'finished', 'abandoned']
        && request.resource.data.players.size() >= 1
        && request.resource.data.players.size() <= 2
        && (
          (request.resource.data.players.size() == 1
            && (request.resource.data.winnerUid == null
              || request.resource.data.winnerUid == request.resource.data.players[0].uid))
          || (request.resource.data.players.size() == 2
            && (request.resource.data.winnerUid == null
              || request.resource.data.winnerUid == request.resource.data.players[0].uid
              || request.resource.data.winnerUid == request.resource.data.players[1].uid))
        )
      // 강제 종료(abandoned)는 해당 학급 선생님만. 그 외 상태 전이는 앱이 지킴
      && (request.resource.data.status != 'abandoned' || teacherOf(get(/databases/(default)/documents/arenas/$(resource.data.arenaId)).data.classroomId));
      // 학급 삭제 때 딸린 대결방을 함께 지우기용 (본인 학급 방만)
      allow delete: if teacherOfRoom(roomId);
    }
    match /battles/{battleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
    match /reports/{id} {
      // 신고 읽기·처리는 해당 학급 선생님만
      allow read: if isSignedIn() && teacherOf(resource.data.classroomId);
      // 신고는 본인 이름으로만, open 상태로만 만든다
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if isSignedIn() && teacherOf(resource.data.classroomId);
      allow delete: if false;
    }
  }
}
